# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
LICENSE text eol=lf
MANIFEST.in text eol=lf
*.ps1 text eol=crlf
*.png binary
